{
  "info": {
    "_postman_id": "c1b6d2fb-9d8e-4e16-9f4f-2f3b2e8b6c01",
    "name": "IOT API",
    "description": "IoT backend API collection. Run Login first; it stores the Bearer token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "change-me"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "date",
      "value": "2026-11-04"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.test('Bearer token received', function () {",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "IoT API",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Control State",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/controls/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "controls",
                "state"
              ]
            }
          }
        },
        {
          "name": "Sensors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sensors"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "Actions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actions?time={{date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actions"
              ],
              "query": [
                {
                  "key": "time",
                  "value": "{{date}}"
                }
              ]
            }
          }
        },
        {
          "name": "Send Control Command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"LED_ON\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/controls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "controls"
              ]
            }
          }
        },
        {
          "name": "Events (SSE)",
          "request": {
            "method": "GET",
            "description": "Keeps the connection open and receives sensor, response, and action events.",
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          }
        }
      ]
    }
  ]
}
