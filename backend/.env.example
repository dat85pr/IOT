PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-password
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=replace-with-mqtt-username
MQTT_PASSWORD=replace-with-mqtt-password
MQTT_CLIENT_ID=iot-dashboard-backend
MQTT_SENSOR_TOPIC=sensor_data
MQTT_CONTROL_TOPIC=device_control
MQTT_RESPONSE_TOPIC=device_response

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=iot_dashboard
MYSQL_CONNECTION_LIMIT=10
